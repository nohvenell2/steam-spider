# ============================================
# Docker Configuration
# ============================================
COMPOSE_PROJECT_NAME=steam-spider

# ============================================
# Steam API Configuration
# ============================================
# Get your Steam API Key from: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_api_key_here

# ============================================
# PostgreSQL Configuration
# ============================================
POSTGRES_BIND_IP=127.0.0.1
POSTGRES_USER=steam_user
POSTGRES_PASSWORD=steam_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=steam_games

# ============================================
# Redis Configuration
# ============================================
REDIS_BIND_IP=127.0.0.1
# REDIS_BIND_IP=0.0.0.0 # production
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Admin
REDIS_ID_ADMIN=ADMIN_ID
REDIS_PW_ADMIN=ADMIM_PW
# Health Checker
REDIS_ID_HEALTH_CHECKER=HEALTH_CHECKER_ID
REDIS_PW_HEALTH_CHECKER=HEALTH_CHECKER_PW
# DB Writer
REDIS_ID_DBWRITER=DWRITER_ID
REDIS_PW_DBWRITER=DWRITER_PW
# Producer-Manager
REDIS_ID_PRODUCER_MONITOR=REDIS_ID_PRODUCER_MONITOR
REDIS_PW_PRODUCER_MONITOR=REDIS_PW_PRODUCER_MONITOR

# Redis TLS/SSL Configuration
REDIS_SSL_ENABLED=true
REDIS_SSL_CA_CERT=/etc/redis/certs/ca-cert.pem
REDIS_SSL_CERT=
REDIS_SSL_KEY=
REDIS_SSL_CHECK_HOSTNAME=false

# ============================================
# DB Writer Configuration
# ============================================
# Batch Processing
BUFFER_SIZE=100
BUFFER_TIMEOUT=30

# Error Handling
MAX_DB_RETRIES=3
RETRY_BASE_DELAY=1.0
RETRY_MAX_DELAY=60.0

# ============================================
# Producer & Monitor Configuration
# ============================================
# Dashboard
DASHBOARD_BIND_IP=127.0.0.1
# DASHBOARD_BIND_IP=0.0.0.0 # production
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5000
REFRESH_INTERVAL=2
REFRESH_INTERVAL_LONG=10 # Sql data refresh intverval second

# Admin Controls
PRODUCER_LOCK_TTL=43200  # Producer lock expiry in seconds (12 hours)

# Rate Limiting (Development: high values, Production: lower values)
RATE_LIMIT_RESET_COUNT=999        # Reset operations allowed per window (dev mode)
RATE_LIMIT_RESET_WINDOW=60        # Reset rate limit window in seconds
RATE_LIMIT_PRODUCER_COUNT=999     # Producer start operations allowed per window (dev mode)
RATE_LIMIT_PRODUCER_WINDOW=60     # Producer start rate limit window in seconds

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=INFO
DB_ECHO=false

# ============================================
# Sheduler Configuration
# ============================================
SCHEDULER_PRODUCER_MODE=test
SCHEDULER_SAMPLE_COUNT=100
SCHEDULER_POLL_INTERVAL=10
SCHEDULER_CLONE_DB_NAME=steam_games_clone
SCHEDULER_MAX_WAIT_TIME=120